# ===== Meta / Instagram =====
META_IG_USER_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
META_GRAPH_API_BASE=https://graph.facebook.com

# ===== Bot =====
BOT_NAME=MELISSA-INSTA-BOT
BOT_NICK=Melissa
BOT_PREFIX=!
BOT_LANG=en
BOT_FALLBACK_LANG=en
SELF_LISTEN=false

# ===== Roles (comma separated IDs) =====
BOT_OWNER_IDS=
BOT_ADMIN_IDS=
DEVELOPER_IDS=
PREMIUM_IDS=
VIP_IDS=

# ===== Database =====
DATABASE_TYPE=json
MONGODB_URI=
MONGODB_DATABASE=melissa

# ===== Server =====
HOST=0.0.0.0
PORT=3000
WEBHOOK_PATH=/webhook

# ===== Limits & Logging =====
MESSAGE_RATE_LIMIT=30
MAX_WEBHOOK_BYTES=1048576
LOG_LEVEL=INFO
RESTART_AFTER_DAYS=10

# ===== Welcome =====
WELCOME_ENABLED=false
WELCOME_MESSAGE=Thanks for messaging MELISSA-INSTA-BOT. Send !help to see available commands.
WELCOME_COOLDOWN_DAYS=30
